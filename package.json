{
  "name": "llm-observe",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @llm-observe/db generate",
    "db:migrate": "pnpm --filter @llm-observe/db migrate",
    "db:push": "pnpm --filter @llm-observe/db push"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
